# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
venv/
env/
ENV/
.venv/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Project specific (datos y ajustes de este equipo)
temp/
config_local.yml
memory.json*
data/
logs/
*.log

# Bases de datos locales (memoria, historial, registro de ejecución), estén donde estén
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Secretos que nunca deben subirse
*.pem
*.key

# Models (if downloaded locally in project)
models/
*.onnx
*.gguf

# Mascota de escritorio (Go + Wails): binarios y builds se generan en cada equipo
*.exe
pet/desktop/build/bin/
pet/desktop/frontend/dist/

# Configuración local de agentes (rutas de este equipo). .claude/settings.json sí se comparte:
# tiene los hooks del tablero de coordinación.
.gemini/
.claude/settings.local.json

# App de Postman: vincula tu workspace (con su ID) a la colección local. La colección
# compartida vive en tests/postman/ y sí se sube.
.postman/
/postman/

# Tablero de coordinación: carpeta local, bloqueo y escritura temporal de scripts/tareas.py
coordinacion/
coordinacion/.tareas.lock
coordinacion/*.tmp

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Voces de referencia personales para clonar (nunca al repositorio)
voices/
audio/

# Material de origen del arte (zips y fotogramas): pesado, se queda en local
/assets/
