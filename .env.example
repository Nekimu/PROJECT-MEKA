# Token del bot generado con @BotFather
TELEGRAM_TOKEN=tu_token_aqui_sin_comillas

# IDs numéricos de Telegram autorizados a hablar con el bot, separados por comas.
# Puedes obtener el tuyo con @userinfobot. Si lo dejas vacío, el bot será PÚBLICO.
ALLOWED_USER_IDS=

# Opcional: personaje activo (carpeta de personas/). Si no se indica, se usa config.yml.
# MEKA_PERSONA=dva
