# Token del bot generado con @BotFather
TELEGRAM_TOKEN=tu_token_aqui_sin_comillas

# IDs numéricos de Telegram autorizados a hablar con el bot, separados por comas.
# Puedes obtener el tuyo con @userinfobot. Si lo dejas vacío, el bot será PÚBLICO.
ALLOWED_USER_IDS=

# Token de MEKA Core. Opcional si todo corre en este equipo (server.host = 127.0.0.1);
# obligatorio para abrirlo a la red local o a Tailscale. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEKA_API_TOKEN=

# Opcional: dirección de MEKA Core si los canales corren en otro equipo
# MEKA_CORE_URL=http://mi-pc.tailnet.ts.net:8765

# Opcional: personaje activo (carpeta de personas/). Si no se indica, se usa config.yml.
# MEKA_PERSONA=dva
