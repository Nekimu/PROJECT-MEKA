{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python scripts/tareas.py hook-session",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python scripts/tareas.py hook-pretooluse --agente claude",
            "timeout": 20,
            "statusMessage": "Comprobando el área del archivo"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python scripts/tareas.py sync > /dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
